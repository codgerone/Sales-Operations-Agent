# 复制为 .env 后使用。以下是仅限本机开发的值，与 compose.yaml 一致。
# 主机写 127.0.0.1 而不是 localhost：本机 localhost 先解析为 IPv6 ::1，连接会挂起直到超时。
DATABASE_URL=postgresql+psycopg://sales_ops:sales_ops_dev@127.0.0.1:5432/sales_ops

# 可选：测试库地址。未设置时取 DATABASE_URL 并把库名改为 <库名>_test。
# TEST_DATABASE_URL=postgresql+psycopg://sales_ops:sales_ops_dev@127.0.0.1:5432/sales_ops_test
